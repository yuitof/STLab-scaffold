{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Markdown preview",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": ["${workspaceFolder}/scripts/preview_markdown.py", "--watch"],
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": {
        "owner": "markdown-preview",
        "pattern": {
          "regexp": "^(.+):(\\d+): (error|warning): (.+)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Watching Markdown drafts and preview",
          "endsPattern": "^Markdown preview watcher ready\\.$"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
