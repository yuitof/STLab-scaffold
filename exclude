# Allowlist for the nested lab-report template repository.
# Tracked as exclude; keep .git/info/exclude identical.
# Include the paths documented in AGENTS.md and empty-folder placeholders.
# All other untracked files, including build and cache files, are excluded.
*

# Traverse directories so .gitkeep can retain new empty folders too.
!*/

# Included directories (parents must be traversable).
!/.vscode/
!/data/
!/docs/
!/docs/instructions/
!/docs/references/
!/docs/references/textbooks/
!/docs/references/textbooks/assests/
!/docs/templates/
!/paper/
!/paper/markdown/
!/paper/submission/
!/paper/tex/
!/paper/tex/sections/
!/scripts/
!/temp/
!/temp/markdown-latex-snapshots/

# Included files.
!/exclude
!/.gitignore
!/.vscode/settings.json
!/.vscode/tasks.json
!/AGENTS.md
!/LICENSE
!/README.md
!/data/cover_info.example.yaml
!/docs/instructions/.gitkeep
!/docs/references/textbooks/assests/.gitkeep
!/docs/references/textbooks/textbook.md
!/docs/templates/template.tex
!/paper/markdown/01.md
!/paper/markdown/02.md
!/paper/markdown/03.md
!/paper/markdown/04.md
!/paper/markdown/05.md
!/paper/markdown/06.md
!/paper/markdown/07.md
!/paper/markdown/cover.md
!/paper/markdown/preview.md
!/paper/submission/.gitkeep
!/paper/tex/paper.tex
!/paper/tex/sections/01.tex
!/paper/tex/sections/02.tex
!/paper/tex/sections/03.tex
!/paper/tex/sections/04.tex
!/paper/tex/sections/05.tex
!/paper/tex/sections/06.tex
!/paper/tex/sections/07.tex
!/paper/tex/sections/cover.tex
!/scripts/preview_markdown.py
!/scripts/markdown_state.py
!/scripts/test_markdown_state.py
!/scripts/test_preview_markdown.py
!/temp/.gitkeep
!/temp/markdown-read-state.json
!/temp/markdown-latex-state.json

# Allow placeholders in included directories.
!**/.gitkeep

# Temporary storage: include the placeholder, Markdown state, and snapshots.
/temp/*
!/temp/
!/temp/.gitkeep
!/temp/markdown-read-state.json
!/temp/markdown-latex-state.json
!/temp/markdown-latex-snapshots/
!/temp/markdown-latex-snapshots/**

# Keep excluded historical folders out of the repository.
**/(old)/
